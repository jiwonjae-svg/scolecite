# =============================================================================
# Project Scolecite - Environment Variables Template
# DISCLAIMER: For educational/research purposes only.
# The authors are NOT responsible for any financial losses.
# =============================================================================
# Copy this file to `.env` and fill in your keys.
# Runtime-tunable settings are managed via the Settings tab → settings.json.
# NEVER commit your .env file to version control.
# =============================================================================

# ---- AI API Keys ----
ANTHROPIC_API_KEY=
XAI_GROK_API_KEY=

# ---- Market Data ----
POLYGON_API_KEY=

# ---- Broker (Alpaca) ----
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Paper: https://paper-api.alpaca.markets
# Live:  https://api.alpaca.markets
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ---- Database ----
# SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./scolecite.db
# PostgreSQL (Cloud Run + Cloud SQL unix socket):
# DATABASE_URL=postgresql+asyncpg://scolecite:PASSWORD@/scolecite?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
# PostgreSQL (direct TCP, e.g. Cloud SQL Auth Proxy on localhost):
# DATABASE_URL=postgresql+asyncpg://scolecite:PASSWORD@127.0.0.1:5432/scolecite
