# =============================================================================
# Project Scolecite - Environment Variables Template
# DISCLAIMER: For educational/research purposes only.
# The authors are NOT responsible for any financial losses.
# =============================================================================
# Copy this file to `.env` and fill in your keys.
# NEVER commit your .env file to version control.
# =============================================================================

# ---- AI API Keys ----
ANTHROPIC_API_KEY=
XAI_GROK_API_KEY=

# ---- Market Data ----
POLYGON_API_KEY=

# ---- Broker (Alpaca) ----
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Paper: https://paper-api.alpaca.markets
# Live:  https://api.alpaca.markets
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# ---- Trading Mode ----
# paper = simulated (default, safe)
# live  = real money (use with extreme caution)
TRADING_MODE=paper

# ---- Risk Management ----
MAX_POSITION_PERCENT=5.0
MAX_DRAWDOWN_PERCENT=8.0
DAILY_LOSS_LIMIT_PERCENT=3.0

# ---- Strategy Loop ----
# Minutes between regular Opus strategy cycles
STRATEGY_UPDATE_INTERVAL_MIN=180
# Minutes between Grok Fast market scans
GROK_SCAN_INTERVAL_MIN=10

# ---- Extended Hours ----
ALLOW_EXTENDED_HOURS=false

# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ---- Database ----
# SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./scolecite.db
# PostgreSQL (Cloud Run):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/scolecite

# ---- Volatility Thresholds ----
PRICE_CHANGE_THRESHOLD_PCT=2.5
VOLUME_SPIKE_MULTIPLIER=3.0
SENTIMENT_DROP_THRESHOLD_PCT=40.0
INDIVIDUAL_DRAWDOWN_PCT=2.5

# ---- AI Cost Control ----
DAILY_AI_BUDGET_USD=50.0
ENABLE_PROMPT_CACHING=true

# ---- Market Fatigue ----
CONSECUTIVE_STOP_LOSS_PAUSE=3
VIX_PANIC_THRESHOLD=30.0

# ---- Dynamic Universe ----
DYNAMIC_UNIVERSE_SIZE=10
ENABLE_DYNAMIC_UNIVERSE=true

# ---- Confidence Thresholds ----
HIGH_CONFIDENCE_THRESHOLD=0.90
LOW_CONFIDENCE_THRESHOLD=0.60
HIGH_CONFIDENCE_POSITION_MULT=1.5
LOW_CONFIDENCE_POSITION_MULT=0.25

# ---- Timezone ----
DISPLAY_TIMEZONE=Asia/Seoul

# ---- DB Backup ----
DB_BACKUP_ENABLED=true
DB_BACKUP_DIR=backups

# ---- Social Noise Filter ----
SOCIAL_NOISE_FILTER_ENABLED=true
LOW_RELIABILITY_WEIGHT=0.2
