# =============================================================================
# Project Scolecite - Environment Variables Template
# DISCLAIMER: For educational/research purposes only.
# The authors are NOT responsible for any financial losses.
# =============================================================================
# Copy this file to `.env` and fill in your keys.
# Runtime-tunable settings are managed via the Settings tab → settings.json.
# NEVER commit your .env file to version control.
# =============================================================================

# ---- AI API Keys ----
ANTHROPIC_API_KEY=
XAI_GROK_API_KEY=

# ---- Market Data ----
POLYGON_API_KEY=

# ---- Broker (Alpaca) ----
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Paper: https://paper-api.alpaca.markets
# Live:  https://api.alpaca.markets
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# ---- Server ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ---- Database ----
# SQLite (local dev):
DATABASE_URL=sqlite+aiosqlite:///./scolecite.db
# PostgreSQL (production on Oracle Cloud VPS via docker-compose):
# DATABASE_URL is auto-set by docker-compose to: postgresql+asyncpg://scolecite:PASSWORD@db:5432/scolecite
# Set these for docker-compose:
# POSTGRES_USER=scolecite
# POSTGRES_PASSWORD=<generate with: openssl rand -base64 32>
# POSTGRES_DB=scolecite
